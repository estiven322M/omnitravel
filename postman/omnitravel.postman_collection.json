    {
      "name": "Proceso 2 — Rutas accesibles",
      "item": [
        {
          "name": "CP-F201 Ruta para silla de ruedas evitando escaleras (RF-01, RNF-21)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('Ruta con distancia, duración y pasos', () => {",
                  "  pm.expect(r.distanciaKm).to.be.above(0);",
                  "  pm.expect(r.duracionMin).to.be.above(0);",
                  "  pm.expect(r.pasos).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(r.shape).to.be.a('string');",
                  "});",
                  "pm.test('Perfil aplicado: silla_de_ruedas', () => pm.expect(r.perfil).to.eql('silla_de_ruedas'));",
                  "pm.test('Responde en ≤ 3 s (RNF-01)', () => pm.expect(pm.response.responseTime).to.be.at.most(3000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_autor}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/routes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "routes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": [\n    4.5339,\n    -75.6811\n  ],\n  \"destination\": [\n    4.537,\n    -75.672\n  ],\n  \"restrictions\": {\n    \"perfil\": \"silla_de_ruedas\",\n    \"avoidStairs\": true,\n    \"requireElevator\": true\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
