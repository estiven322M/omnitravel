    {
      "name": "Proceso 2 · Planificación de Rutas Accesibles",
      "item": [
        {
          "name": "CP-027 · Ruta peatonal estándar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
