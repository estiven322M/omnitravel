            ],
            "url": {
              "raw": "{{baseUrl}}/routes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "routes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": [\n    4.5339,\n    -75.6811\n  ],\n  \"destination\": [\n    4.5534,\n    -75.6586\n  ],\n  \"restrictions\": {\n    \"perfil\": \"peatonal\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 con ruta', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('distancia, duración, shape y pasos', () => {",
                  "  pm.expect(r.distanciaKm).to.be.above(0);",
                  "  pm.expect(r.duracionMin).to.be.above(0);",
                  "  pm.expect(r.shape).to.be.a('string');",
                  "  pm.expect(r.pasos).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.test('responde en ≤ 3 s (RNF-01)', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "pm.test('perfil peatonal', () => pm.expect(r.perfil).to.eql('peatonal'));"
                ]
              }
            }
          ]
        },
