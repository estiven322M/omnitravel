              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const pois = pm.response.json().pois;",
                  "pm.test('hay al menos un lugar publicado', () => pm.expect(pois.some(p => p.estado === 'publicado')).to.be.true);",
