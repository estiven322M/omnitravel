{
  "expo": {
    "owner": "yamis2706s-team",
    "name": "OmniTravel",
    "slug": "omnitravel",
    "scheme": "omnitravel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.omnitravel.app"
    },
    "android": {
      "package": "com.omnitravel.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "OmniTravel usa Face ID para que entres a tu cuenta sin escribir la contraseña."
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "OmniTravel usa tus fotos para adjuntar evidencia de accesibilidad de los lugares.",
          "cameraPermission": "OmniTravel usa la cámara para capturar evidencia de accesibilidad de los lugares.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b9a0f082-e6dc-4bec-9957-75a8b0ce0834"
      }
    }
  }
}
