PORT=3000

# Cadena de conexión de PostgreSQL (los caracteres especiales de la contraseña deben ir codificados, ej. ? -> %3F, + -> %2B)
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:5432/NOMBRE_BD
DB_SSL=true

# Secreto para firmar los tokens de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto

VALHALLA_URL=http://localhost:8002
