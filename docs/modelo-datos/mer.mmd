    bigint id_caracteristica PK
    text nombre UK
    text descripcion "opcional"
    text tipo_valor
    boolean activa
  }
  confirmacion {
    bigint id_confirmacion PK
    bigint reporte_id FK
    bigint usuario_id FK
    text tipo_confirmacion
    timestamptz fecha
  }
