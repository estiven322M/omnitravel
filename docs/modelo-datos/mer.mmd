    text direccion "opcional"
    geometry_point ubicacion
    text estado
    timestamptz fecha_creacion
    timestamptz fecha_actualizacion
  }
  poi_foto {
    bigint id_foto PK
    bigint poi_id FK
    text url
    text leyenda "opcional"
    text autor "opcional"
    text licencia "opcional"
    text fuente_url "opcional"
    integer orden
  }
  registro_auditoria {
    bigint id_auditoria PK
    bigint usuario_id FK "opcional"
    text accion
    jsonb detalle "opcional"
    timestamptz fecha
  }
  reporte {
    bigint id_reporte PK
    bigint poi_id FK
    bigint usuario_creador_id FK "opcional"
    text tipo
    text descripcion "opcional"
    text estado
    text via_resolucion "opcional"
    timestamptz fecha_creacion
    timestamptz fecha_resolucion "opcional"
    boolean es_critico
  }
  retroalimentacion {
    bigint id_retroalimentacion PK
    bigint usuario_id FK "opcional"
    bigint poi_id FK
    smallint calificacion
    text comentario "opcional"
    timestamptz fecha
    bigint visita_id FK, UK "opcional"
  }
  rol {
    bigint id_rol PK
    text nombre_rol UK
  }
  solicitud_reverificacion {
    bigint id_solicitud PK
    bigint incidencia_id FK, UK
    bigint reporte_generado_id FK "opcional"
    text estado
    timestamptz fecha_creacion
    timestamptz fecha_resolucion "opcional"
  }
  usuario {
    bigint id_usuario PK
    text email UK
    text password_hash
    bigint rol_id FK
    timestamptz fecha_registro
    text estado_cuenta
    uuid auth_user_id "opcional"
  }
  valor_accesibilidad_poi {
    bigint id_valor PK
    bigint poi_id FK
    bigint caracteristica_id FK
    text valor_texto "opcional"
    numeric valor_numerico "opcional"
    boolean valor_booleano "opcional"
    timestamptz fecha_actualizacion
  }
  valor_caracteristica_reporte {
    bigint id_valor_reporte PK
    bigint reporte_id FK
    bigint caracteristica_id FK
    text valor_texto "opcional"
    numeric valor_numerico "opcional"
    boolean valor_booleano "opcional"
  }
  visita {
    bigint id_visita PK
    bigint usuario_id FK
    bigint poi_id FK
    text estado
    timestamptz fecha_inicio
    timestamptz fecha_fin "opcional"
  }
