    timestamptz fecha_registro_participacion "opcional"
  }
  evidencia {
    bigint id_evidencia PK
    bigint reporte_id FK
    text storage_key
    text tipo
    timestamptz fecha
  }
  favorito {
    bigint usuario_id PK, FK
    bigint poi_id PK, FK
    timestamptz fecha
  }
  incidencia {
    bigint id_incidencia PK
    bigint retroalimentacion_id FK
    text tipo
    text descripcion "opcional"
    text estado
    timestamptz fecha_creacion
    timestamptz fecha_resolucion "opcional"
  }
  moderacion {
    bigint id_moderacion PK
    bigint reporte_id FK
    bigint moderador_id FK "opcional"
    text accion
    text motivo "opcional"
    timestamptz fecha
  }
  poi {
    bigint id_poi PK
    text nombre
    text descripcion "opcional"
